POSTGRES_DB=daily_outfit_weather
POSTGRES_USER=daily_outfit_weather
POSTGRES_PASSWORD=change-this-postgres-password

# GCP VM public HTTP endpoint.
# If you add HTTPS/domain later, change every http://<GCP_VM_PUBLIC_IP> value together.
SPRING_PROFILES_ACTIVE=prod
FRONTEND_PORT=80
APP_FRONTEND_SUCCESS_URL=http://<GCP_VM_PUBLIC_IP>
APP_SECURITY_ALLOWED_ORIGINS=http://<GCP_VM_PUBLIC_IP>
APP_NOTIFICATION_GENERATE_DUE_TOKEN=change-this-long-random-token

# Plain HTTP endpoints require secure cookies to stay false until HTTPS is configured.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

GOOGLE_CLIENT_ID=change-this-google-client-id
GOOGLE_CLIENT_SECRET=change-this-google-client-secret
GOOGLE_REDIRECT_URI=http://<GCP_VM_PUBLIC_IP>/login/oauth2/code/google

# Use the public data portal Encoding key.
KMA_SERVICE_KEY=change-this-kma-encoding-key
KMA_BASE_URL=http://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
KMA_CONNECT_TIMEOUT=2s
KMA_READ_TIMEOUT=3s

# Keep recommendations available if KMA is temporarily unavailable.
APP_WEATHER_FALLBACK_ENABLED=true
