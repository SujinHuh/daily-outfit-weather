POSTGRES_DB=daily_outfit_weather
POSTGRES_USER=daily_outfit_weather
POSTGRES_PASSWORD=change-this-postgres-password

# GCP VM public HTTP endpoint for temporary single-user use.
SPRING_PROFILES_ACTIVE=prod
FRONTEND_PORT=8080
APP_FRONTEND_SUCCESS_URL=http://34.22.67.160
APP_SECURITY_ALLOWED_ORIGINS=http://34.22.67.160
APP_NOTIFICATION_GENERATE_DUE_TOKEN=change-this-long-random-token

# Plain HTTP endpoints require secure cookies to stay false until HTTPS is configured.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# Keep temporary-login browser sessions after the browser is closed.
# Server restarts still invalidate in-memory sessions unless Spring Session persistence is added later.
SESSION_TIMEOUT=30d
SESSION_COOKIE_MAX_AGE=30d

# Keep existing Google values for prod startup, even if temporary login is used.
GOOGLE_CLIENT_ID=change-this-google-client-id
GOOGLE_CLIENT_SECRET=change-this-google-client-secret
GOOGLE_REDIRECT_URI=http://34.22.67.160/login/oauth2/code/google

# Temporary login bypass. Use a private password and do not commit the real file.
APP_TEMP_LOGIN_ENABLED=true
APP_TEMP_LOGIN_PASSWORD=change-this-private-temp-login-password
APP_TEMP_LOGIN_EMAIL=temp-user@daily-outfit-weather.local
APP_TEMP_LOGIN_NICKNAME=임시 사용자

# Use the public data portal Encoding key.
KMA_SERVICE_KEY=change-this-kma-encoding-key
KMA_BASE_URL=http://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
KMA_CONNECT_TIMEOUT=2s
KMA_READ_TIMEOUT=3s

# Keep recommendations available if KMA is temporarily unavailable.
APP_WEATHER_FALLBACK_ENABLED=true
